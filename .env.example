# ============================================================
# ImmoPlatform — Template variables d'environnement
# Copier en .env.local et remplir les vraies valeurs.
# .env.local ne doit JAMAIS être commité.
# ============================================================

# Base de données (Supabase PostgreSQL en prod, service postgres en Docker local)
DATABASE_URL="postgresql://immoplatform:immoplatform@localhost:5432/immoplatform?schema=public"
DIRECT_URL="postgresql://immoplatform:immoplatform@localhost:5432/immoplatform?schema=public"

# Auth Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""

# Cache Redis (Upstash en prod — URL rediss://, service redis en Docker local)
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# IA — CÔTÉ SERVEUR UNIQUEMENT, jamais NEXT_PUBLIC_
ANTHROPIC_API_KEY=""

# Paiement Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_AGENCY_MONTHLY=""

# Stockage Cloudflare R2
CLOUDFLARE_R2_ENDPOINT=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="immoplatform"
NEXT_PUBLIC_R2_PUBLIC_URL=""

# Email Resend
RESEND_API_KEY=""

# Cartes Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=""
MAPBOX_SECRET_TOKEN=""

# APIs françaises (gratuites)
DVF_API_URL="https://api.data.gouv.fr/api/dvf/v1"
BAN_API_URL="https://api-adresse.data.gouv.fr"
ADEME_API_URL="https://data.ademe.fr/data-fair/api/v1/datasets"
GEORISQUES_API_KEY=""
INSEE_API_KEY=""

# Annonces (payant — programme startup)
STREAM_ESTATE_API_KEY=""

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
