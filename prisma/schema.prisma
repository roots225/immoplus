// ImmoPlatform — Schéma Prisma complet (16 modèles)
// Supabase PostgreSQL en prod, service postgres en Docker local.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  INCOMPLETE
}

enum AgencyRole {
  OWNER
  ADMIN
  AGENT
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PropertyType {
  APARTMENT
  HOUSE
  LAND
  COMMERCIAL
  OTHER
}

enum RenovCategory {
  ROOF
  ELECTRICAL
  PLUMBING
  HEATING
  INSULATION
  WINDOWS
  KITCHEN
  BATHROOM
  FLOORING
  PAINTING
  FACADE
  OTHER
}

enum DealStatus {
  ACTIVE
  EXPIRED
  SOLD
  REMOVED
}

enum VoteType {
  HOT
  COLD
}

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

enum BuyerStatus {
  PROSPECT
  ACTIVE
  OFFER_MADE
  CLOSED
  LOST
}

// ------------------------------------------------------------
// Utilisateurs & abonnements
// ------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription   Subscription?
  analyses       Analysis[]
  renovEstimates RenovEstimate[]
  deals          Deal[]
  votes          Vote[]
  comments       Comment[]
  commentLikes   CommentLike[]
  savedDeals     SavedDeal[]
  alerts         UserAlert[]
  agencyMembers  AgencyMember[]
  auditLogs      AuditLog[]

  @@index([clerkId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  // Compteurs de quotas — remis à zéro chaque début de période
  analysesUsed         Int                @default(0)
  renovUsed            Int                @default(0)
  quotaResetAt         DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

// ------------------------------------------------------------
// AgencePro (B2B)
// ------------------------------------------------------------

model Agency {
  id        String   @id @default(cuid())
  name      String
  siret     String?  @unique
  logoUrl   String?
  // White-label : couleurs et pied de page des rapports PDF
  brandColor String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members AgencyMember[]
  buyers  AgencyBuyer[]
  reports Report[]
}

model AgencyMember {
  id       String     @id @default(cuid())
  agencyId String
  agency   Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     AgencyRole @default(AGENT)
  joinedAt DateTime   @default(now())

  @@unique([agencyId, userId])
}

model AgencyBuyer {
  id          String      @id @default(cuid())
  agencyId    String
  agency      Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String?
  phone       String?
  status      BuyerStatus @default(PROSPECT)
  budgetMin   Int?
  budgetMax   Int?
  cities      String[]
  propertyType PropertyType?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([agencyId, status])
}

// ------------------------------------------------------------
// ImmoScore
// ------------------------------------------------------------

model Analysis {
  id     String         @id @default(cuid())
  userId String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status AnalysisStatus @default(PENDING)

  // Annonce source
  sourceUrl    String
  title        String?
  price        Int?
  surface      Float?
  rooms        Int?
  propertyType PropertyType?
  address      String?
  city         String?
  postalCode   String?
  latitude     Float?
  longitude    Float?

  // Scores /100
  scoreGlobal    Int?
  scorePrice     Int?
  scoreDpe       Int?
  scoreRisks     Int?
  scoreTransport Int?
  scoreDistrict  Int?

  // Données brutes des APIs (JSON) — DVF, ADEME, Géorisques, INSEE
  dvfData        Json?
  dpeData        Json?
  risksData      Json?
  transportData  Json?
  districtData   Json?

  // Synthèse
  pricePerSqm       Float?
  marketMedianSqm   Float?
  priceGapPercent   Float?
  negotiationMargin Float?
  aiSummary         String?
  errorMessage      String?

  reports   Report[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([sourceUrl])
}

// ------------------------------------------------------------
// RenovAI
// ------------------------------------------------------------

model RenovEstimate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  photoUrls    String[]
  surface      Float?
  propertyType PropertyType?
  totalMin     Int?
  totalMax     Int?
  aiNotes      String?
  status       AnalysisStatus @default(PENDING)

  items     RenovItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId, createdAt])
}

model RenovItem {
  id         String        @id @default(cuid())
  estimateId String
  estimate   RenovEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  category   RenovCategory
  label      String
  costMin    Int
  costMax    Int
  priority   Int           @default(3) // 1 = urgent, 5 = confort
}

// ------------------------------------------------------------
// ImmoDeal (communauté)
// ------------------------------------------------------------

model Deal {
  id     String     @id @default(cuid())
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status DealStatus @default(ACTIVE)

  title        String
  description  String
  sourceUrl    String?
  price        Int
  surface      Float?
  city         String
  postalCode   String
  propertyType PropertyType @default(APARTMENT)
  imageUrl     String?

  // Dénormalisé pour le tri (recalculé à chaque vote)
  hotScore Int @default(0)

  votes      Vote[]
  comments   Comment[]
  savedBy    SavedDeal[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status, hotScore])
  @@index([city, postalCode])
}

model Vote {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VoteType
  createdAt DateTime @default(now())

  @@unique([dealId, userId])
}

model Comment {
  id      String  @id @default(cuid())
  dealId  String
  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content String

  // Imbrication limitée à 2 niveaux (vérifiée côté API)
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  likes     CommentLike[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([dealId, createdAt])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model SavedDeal {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([dealId, userId])
}

// ------------------------------------------------------------
// Alertes acheteurs
// ------------------------------------------------------------

model UserAlert {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  city         String
  postalCodes  String[]
  budgetMin    Int?
  budgetMax    Int?
  surfaceMin   Float?
  propertyType PropertyType?
  frequency    AlertFrequency @default(DAILY)
  active       Boolean        @default(true)
  lastSentAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([active, frequency])
}

// ------------------------------------------------------------
// Rapports PDF & audit RGPD
// ------------------------------------------------------------

model Report {
  id         String    @id @default(cuid())
  analysisId String
  analysis   Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  agencyId   String?
  agency     Agency?   @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  pdfUrl     String
  whiteLabel Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([agencyId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // ex: "analysis.create", "user.delete", "export.rgpd"
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
